{
  "name": "guardian-web-quality",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lint:js": "eslint web/static/app.js",
    "check:js": "node --check web/static/app.js",
    "format:check": "prettier --check \"web/**/*.{html,css,js}\" eslint.config.js package.json",
    "format:write": "prettier --write \"web/**/*.{html,css,js}\" eslint.config.js package.json"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.6.0"
  }
}
