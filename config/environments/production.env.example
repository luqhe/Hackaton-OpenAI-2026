GUARDIAN_ENVIRONMENT=production
GUARDIAN_API_URL=https://guardian.invalid
GUARDIAN_DATABASE_URL=postgresql://guardian:CHANGE_ME@db.production.invalid/guardian?sslmode=verify-full
GUARDIAN_DATABASE_POOL_MIN=2
GUARDIAN_DATABASE_POOL_MAX=16
GUARDIAN_OBJECT_STORE_PROVIDER=s3
GUARDIAN_OBJECT_STORE_BUCKET=CHANGE_ME_PRIVATE_BUCKET
GUARDIAN_OBJECT_STORE_ENDPOINT=https://objects.production.invalid
GUARDIAN_KMS_KEY_ID=CHANGE_ME_KMS_KEY_ID
GUARDIAN_AUDIT_HMAC_KEY_ID=CHANGE_ME_AUDIT_KEY_ID
GUARDIAN_AUDIT_HMAC_SECRET=CHANGE_ME_SECRET_PROVIDER_VALUE
GUARDIAN_RATE_LIMIT_HMAC_SECRET=CHANGE_ME_SECRET_PROVIDER_VALUE
GUARDIAN_EVIDENCE_GRANT_TTL_SECONDS=120
GUARDIAN_LOG_LEVEL=WARNING
GUARDIAN_AUTOMATIC_BLOCKING_ENABLED=false
GUARDIAN_REAL_ENFORCEMENT_ENABLED=false
GUARDIAN_RELEASE_GATE_APPROVED=false

